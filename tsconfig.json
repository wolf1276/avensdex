{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["packages/funding/preview.ts", "packages/funding/controller.ts", "packages/protocol/*.ts", "packages/clob/*.ts", "services/clob/*.ts", "services/appwrite/*.ts"]
}
