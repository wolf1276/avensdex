{
  "name": "avensdex",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": { "node": "22.22.3", "npm": "10.9.8" },
  "packageManager": "npm@10.9.8",
  "scripts": {
    "typecheck": "tsc --project tsconfig.json",
    "test:funding": "node --experimental-strip-types --test packages/funding/preview.test.ts",
    "test:funding:rust": "cargo test --locked --manifest-path packages/funding/reference/Cargo.toml",
    "test:network": "python3 -m unittest discover -s scripts -t . -v",
    "test:contracts": "forge test --root contracts/evm",
    "test": "npm run typecheck && npm run test:funding && npm run test:network && npm run test:contracts"
  },
  "devDependencies": { "typescript": "5.9.3" }
}
